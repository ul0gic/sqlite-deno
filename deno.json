{
  "name": "@scope/sqlite",
  "version": "0.0.0",
  "exports": "./src/mod.ts",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check src/mod.ts && deno task lint:biome && deno test -A",
    "lint:biome": "bash tools/install-biome.sh && tools/.bin/biome lint --error-on-warnings .",
    "test": "deno test -A",
    "bench": "deno bench -A",
    "build": "deno run -A build/build.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [".claude/", ".project/", "src/wasm/sqlite3.mjs", "src/wasm/index.d.mts"]
  },
  "lint": {
    "exclude": [".claude/", ".project/", "src/wasm/sqlite3.mjs", "src/wasm/index.d.mts"],
    "rules": {
      "tags": ["recommended", "jsr"],
      "include": [
        "ban-untagged-todo",
        "default-param-last",
        "eqeqeq",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-console",
        "no-eval",
        "no-external-import",
        "no-implicit-declare-namespace-export",
        "no-node-globals",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sparse-arrays",
        "no-throw-literal",
        "no-useless-rename",
        "single-var-declarator",
        "verbatim-module-syntax"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.5"
  }
}
