{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": ["src/**", "test/**"]
  },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "domains": { "types": "recommended" },
    "rules": {
      "recommended": true,
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error"
      }
    }
  }
}
